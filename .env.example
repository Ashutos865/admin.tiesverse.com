# Supabase — service key (NEVER expose to frontend)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-key-from-supabase-dashboard>

# Django
SECRET_KEY=your-django-secret-key
DEBUG=True
# Every hostname nginx proxies to this app, not just the login one. A host
# missing here answers 'Bad Request (400)' - unsubscribe links broke this way.
ALLOWED_HOSTS=admin.tiesverse.com,mail.tiesverse.com,forms.tiesverse.com,docs.tiesverse.com,localhost,127.0.0.1

# AWS SES (transactional email). Leave creds blank to keep all email stubbed
# to the console. Each *_EMAIL_ENABLED flag must ALSO be True for real sending.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=ap-south-1
SES_FROM_EMAIL=noreply@tiesverse.com
SES_CAREERS_FROM_EMAIL=careers@tiesverse.com

# Per-purpose email switches (default False until SES senders are verified)
ONBOARDING_EMAIL_ENABLED=False
OFFER_EMAIL_ENABLED=False
CERT_EMAIL_ENABLED=False
PASSWORD_RESET_EMAIL_ENABLED=False

# Public URLs
WEBSITE_URL=https://tiesverse.com
ADMIN_PORTAL_URL=http://localhost:5173

# ── WhatsApp notifications (official Meta WhatsApp Cloud API) ──
# Leave blank to keep WhatsApp dormant: nothing is sent and every attempt is
# logged as 'skipped (not configured)'. Fill these in and restart to go live.
#   1. developers.facebook.com -> create Business app -> add WhatsApp
#   2. WhatsApp -> API Setup gives the phone number id
#   3. Business Settings -> Users -> System Users -> generate a PERMANENT token
#      with whatsapp_business_messaging + whatsapp_business_management
#   4. WhatsApp Manager -> Message Templates -> create 'content_assigned'
#      (Utility category, 5 body variables)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ENABLED=False
WHATSAPP_DAILY_CAP=200
WHATSAPP_TEMPLATE_ASSIGNED=content_assigned
WHATSAPP_TEMPLATE_LANG=en
